@model GeoSolution.Models.CustomBuildingModel

@if (User.IsInRole("Admin"))
{
    <h2>Create Building</h2>
    <form asp-action="Create" method="post">
        <div class="form-group">
            <label>Name</label>
            <input asp-for="Name" class="form-control" />
        </div>
        <div class="form-group">
            <label>Type</label>
            <input asp-for="BuildingType" class="form-control" />
        </div>
        <div class="form-group">
            <label>Description</label>
            <textarea asp-for="Description" class="form-control"></textarea>
        </div>
        <div class="form-group">
            <label for="Color">Цвет</label>
            <input asp-for="Color" type="color" class="form-control" />
        </div>
        <div class="form-group">
            <label>Geometry</label>
            <textarea asp-for="Geometry" class="form-control"></textarea>
        </div>

        <h4>Entrances</h4>
        <div id="entrances-list">
        </div>
        <button type="button" id="add-entrance" class="btn btn-secondary">Add Entrance</button>

        <button type="submit" class="btn btn-primary">Save</button>
    </form>

    @section Scripts {
    <script>
        let entranceIndex = 0;

        document.getElementById('add-entrance').addEventListener('click', function () {
            const container = document.getElementById('entrances-list');
            const newEntrance = document.createElement('div');
            newEntrance.className = "form-group border p-2 my-2";
            newEntrance.id = `entrance-${entranceIndex}`;
            newEntrance.innerHTML = `
                <div class="d-flex justify-content-between align-items-center">
                    <h5>Entrance #${entranceIndex + 1}</h5>
                    <button type="button" class="btn btn-danger btn-sm" onclick="removeEntrance(${entranceIndex})">Remove</button>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label>Latitude</label>
                        <input name="Entrances[${entranceIndex}].Latitude" class="form-control" required />
                    </div>
                    <div class="form-group col-md-6">
                        <label>Longitude</label>
                        <input name="Entrances[${entranceIndex}].Longitude" class="form-control" required />
                    </div>
                </div>
                <div class="form-group">
                    <label>Type</label>
                    <input name="Entrances[${entranceIndex}].EntranceType" class="form-control" required />
                </div>
                <div class="form-group">
                    <label>Access Level</label>
                    <input name="Entrances[${entranceIndex}].AccessLevel" class="form-control" required />
                </div>
                <div class="form-group">
                    <label>Color</label>
                    <input name="Entrances[${entranceIndex}].Color" class="form-control" />
                </div>
                <div class="form-group">
                    <label>Geometry</label>
                    <textarea name="Entrances[${entranceIndex}].Geometry" class="form-control"></textarea>
                </div>`;
            container.appendChild(newEntrance);
            entranceIndex++;
        });

        function removeEntrance(index) {
            const entranceElement = document.getElementById(`entrance-${index}`);
            if (entranceElement) {
                entranceElement.remove();
            }
        }
    </script>
    }
}
