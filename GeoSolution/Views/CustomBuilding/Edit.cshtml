@model GeoSolution.Models.CustomBuildingEditViewModel
 @if (User.IsInRole("Admin"))
 {
    <h2>Edit Building</h2>
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="form-group">
            <label>Name</label>
            <input asp-for="Name" class="form-control" />
        </div>
        <div class="form-group">
            <label>Type</label>
            <input asp-for="BuildingType" class="form-control" />
        </div>
        <div class="form-group">
            <label>Description</label>
            <textarea asp-for="Description" class="form-control"></textarea>
        </div>
        <div class="form-group">
            <label for="Color">Цвет</label>
            <input asp-for="Color" type="color" class="form-control" />
        </div>
        <div class="form-group">
            <label>GeometryText</label>
            <textarea asp-for="GeometryText" class="form-control"></textarea>
        </div>

        <h4>Entrances</h4>
        <ul>
            @foreach (var entrance in Model.Entrances)
            {
                <li>
                    <form method="post"></form>
                    Type: @entrance.EntranceType, Access: @entrance.AccessLevel
                    <a asp-controller="EntranceData" asp-action="Edit" asp-route-id="@entrance.Id" class="btn btn-sm btn-warning">Edit</a>
                    <form asp-controller="EntranceData" asp-action="Delete" asp-route-id="@entrance.Id" method="post" style="display:inline-block;">
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                </li>
            }
        </ul>

        <a asp-controller="EntranceData" asp-action="Create" asp-route-buildingId="@Model.Id" class="btn btn-secondary">Add Entrance</a>

        <button type="submit" class="btn btn-primary">Save</button>
    </form>
 }


