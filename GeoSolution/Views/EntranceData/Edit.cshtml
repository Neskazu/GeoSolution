@model GeoSolution.Models.EntranceDataModel
 @if (User.IsInRole("Admin"))
 {
    <h2>Edit Entrance</h2>

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CustomBuildingModelId" />
        <div class="form-row">
            <div class="form-group col-md-6">
                <label asp-for="Latitude"></label>
                <input asp-for="Latitude" class="form-control" />
                <span asp-validation-for="Latitude" class="text-danger"></span>
            </div>
            <div class="form-group col-md-6">
                <label asp-for="Longitude"></label>
                <input asp-for="Longitude" class="form-control" />
                <span asp-validation-for="Longitude" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="EntranceType"></label>
            <input asp-for="EntranceType" class="form-control" />
            <span asp-validation-for="EntranceType" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="AccessLevel"></label>
            <input asp-for="AccessLevel" class="form-control" />
            <span asp-validation-for="AccessLevel" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Color"></label>
            <input asp-for="Color" class="form-control" type="color" />
            <span asp-validation-for="Color" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Geometry"></label>
            <textarea asp-for="Geometry" class="form-control"></textarea>
            <span asp-validation-for="Geometry" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>

 }
